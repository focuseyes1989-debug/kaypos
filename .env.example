# Copy needed keys into .env for local development.

# SQLite is the default when this key is omitted.
ZAY_POS_DB_BACKEND=sqlite

# PostgreSQL app-wide backend:
# ZAY_POS_DB_BACKEND=postgres
# ZAY_POS_DATABASE_URL=postgresql://zay_pos_user:your_password@localhost:5432/zay_pos

# Offline-first cloud sync keeps the local database as primary and pushes
# operational data to a cloud PostgreSQL database when internet is available.
ZAY_POS_CLOUD_SYNC_ENABLED=0
# ZAY_POS_CLOUD_DATABASE_URL=postgresql://avnadmin:your_password@your-aiven-host:16365/defaultdb?sslmode=require
ZAY_POS_CLOUD_SYNC_INTERVAL_SECONDS=300
ZAY_POS_BRANCH_ID=shop_001
ZAY_POS_DEVICE_ID=pos_counter_01

# Telegram integration:
TELEGRAM_ENABLED=0
TELEGRAM_LISTENER_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Staff approval PIN required when an owner requests another copy after a completed print.
ZAY_CAR_REPRINT_PIN=
