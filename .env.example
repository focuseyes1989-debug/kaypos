# Copy needed keys into .env for local development.

# SQLite is the default when this key is omitted.
ZAY_POS_DB_BACKEND=sqlite

# PostgreSQL app-wide backend:
# ZAY_POS_DB_BACKEND=postgres
# ZAY_POS_DATABASE_URL=postgresql://zay_pos_user:your_password@localhost:5432/zay_pos

# Telegram integration:
TELEGRAM_ENABLED=0
TELEGRAM_LISTENER_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
